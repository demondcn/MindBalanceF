{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev --include=optional",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api-docs",
      "destination": "https://mindbalance-backend-n8bh.onrender.com/api-docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://mindbalance-backend-n8bh.onrender.com/openapi.json"
    },
    {
      "source": "/api/:path*",
      "destination": "https://mindbalance-backend-n8bh.onrender.com/api/:path*"
    }
  ]
}
